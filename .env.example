OPENAI_API_KEY=
# OpenAI model name only, without a provider prefix. The program uses openai:<this value>.
OPENAI_MODEL=
# Recent complete turns kept for the next request. 0 keeps none.
AGENT_MAX_HISTORY_TURNS=6
# Reject a request before generation when its input exceeds this many tokens.
AGENT_MAX_REQUEST_INPUT_TOKENS=4096
# Provider-side maximum tokens for each generated response.
AGENT_MAX_OUTPUT_TOKENS=256
# Paid model requests allowed for one chat turn. A turn that uses the date/time
# tool needs at least 2. A larger value allows more paid requests per turn.
# Positive integers only. A turn that reaches the limit fails and is not saved.
AGENT_MAX_MODEL_REQUESTS_PER_TURN=4
# Saved facts added to an ordinary chat request. 0 disables recall.
# A positive value allows matching saved facts to be sent to the configured
# OpenAI model. Accepted values are integers from 0 through 3.
AGENT_MAX_RECALLED_MEMORIES=0
# SQLite file for local conversation history. A relative path is resolved
# from the current working directory. The file stays on this computer.
AGENT_DB_PATH=robot-agent.sqlite3
# Summarize older turns of a session once this many have left the history window.
# 0 disables summaries. A positive value sends older conversation text to the
# configured OpenAI model in a separate request and stores the result in
# AGENT_DB_PATH. A larger value makes fewer summary requests but leaves up to
# value - 1 older turns out of context until the next summary.
AGENT_SUMMARY_AFTER_TURNS=0
# Daily budget for model requests, counted per local calendar date across all
# sessions and restarts. 0 means no limit; both 0 turns the feature off.
# Requests are the model requests reported for a run (a turn that calls a tool
# can use more than one). Tokens are provider-reported input plus output.
# Chat and summary requests both count. The limit is a best-effort guard: the
# run that reaches it may cross it, and a response without usage is undercounted.
# Once a limit is reached, ordinary lines are refused until the next local date.
AGENT_DAILY_MAX_REQUESTS=0
AGENT_DAILY_MAX_TOKENS=0
# Budget for model requests per session (the conversation selected by /new and
# /resume), stored in AGENT_DB_PATH and kept across restarts. 0 means no limit;
# both 0 turns the feature off. Requests and tokens are counted as for the daily
# budget, and chat and summary requests both count. Counting starts when a limit
# is enabled, so earlier usage in an existing session is not counted. Once a
# limit is reached, ordinary lines in that session are refused; /new starts a
# session with fresh counters, and the daily budget remains the limit across
# sessions. The limit is a best-effort guard: the run that reaches it may cross it.
AGENT_SESSION_MAX_REQUESTS=0
AGENT_SESSION_MAX_TOKENS=0

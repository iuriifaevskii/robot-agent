OPENAI_API_KEY=
# OpenAI model name only, without a provider prefix. The program uses openai:<this value>.
OPENAI_MODEL=
# Recent complete turns kept for the next request. 0 keeps none.
AGENT_MAX_HISTORY_TURNS=6
# Reject a request before generation when its input exceeds this many tokens.
AGENT_MAX_REQUEST_INPUT_TOKENS=4096
# Provider-side maximum tokens for each generated response.
AGENT_MAX_OUTPUT_TOKENS=256
# Saved facts added to an ordinary chat request. 0 disables recall.
# A positive value allows matching saved facts to be sent to the configured
# OpenAI model. Accepted values are integers from 0 through 3.
AGENT_MAX_RECALLED_MEMORIES=0
# SQLite file for local conversation history. A relative path is resolved
# from the current working directory. The file stays on this computer.
AGENT_DB_PATH=robot-agent.sqlite3
# Summarize older turns of a session once this many have left the history window.
# 0 disables summaries. A positive value sends older conversation text to the
# configured OpenAI model in a separate request and stores the result in
# AGENT_DB_PATH. A larger value makes fewer summary requests but leaves up to
# value - 1 older turns out of context until the next summary.
AGENT_SUMMARY_AFTER_TURNS=0
